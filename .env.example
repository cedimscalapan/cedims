# =============================================================================
# Smart E-VISION — Environment Variables
# Copy to `.env` locally, or set these in Vercel > Project > Settings > Environment Variables
# =============================================================================

# Supabase project URL (project ref dashboard URL)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Backblaze B2 Cloud Storage (for document storage)
B2_ENDPOINT=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Google Apps Script web app URL for Word -> PDF conversion fallback.
# Deploy google_apps_script.js (Script editor > Deploy > New deployment > Web app)
# and paste the /exec URL here. Optional: when empty, the server-side LibreOffice proxy is used.
PUBLIC_GOOGLE_SCRIPT_URL=

# Service-role key for admin operations (creating users, bypassing RLS).
# Get from: Supabase Dashboard > Project Settings > API > service_role key.
# REQUIRED for the admin create-user endpoint. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (VAPID) — used at runtime from the `system_settings` table,
# not read from env directly. See notifications.ts.
